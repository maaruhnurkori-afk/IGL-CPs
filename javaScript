const keranjang = {};

function formatRupiah(angka) {
  return "Rp" + angka.toLocaleString("id-ID");
}

function tampilkanMenu(data, idTempat) {
  const tempat = document.getElementById(idTempat);
  tempat.innerHTML = "";

  data.forEach((menu) => {
    const kartu = document.createElement("article");
    kartu.className = "kartu";

    const foto = document.createElement("img");
    foto.src = menu.gambar;
    foto.alt = menu.nama;
    foto.loading = "lazy";

    foto.onerror = function () {
      this.onerror = null;
      this.src =
        "https://placehold.co/600x400/f3eee5/176b3a?text=" +
        encodeURIComponent(menu.nama);
    };

    const isi = document.createElement("div");
    isi.className = "isi-kartu";

    const nama = document.createElement("h3");
    nama.textContent = menu.nama;

    const harga = document.createElement("p");
    harga.className = "harga";
    harga.textContent = formatRupiah(menu.harga);

    const tombol = document.createElement("button");
    tombol.textContent = "+ Tambah Pesanan";

    tombol.addEventListener("click", () => {
      if (!keranjang[menu.nama]) {
        keranjang[menu.nama] = { ...menu, jumlah: 0 };
      }

      keranjang[menu.nama].jumlah++;
      tampilkanKeranjang();
    });

    isi.append(nama, harga, tombol);
    kartu.append(foto, isi);
    tempat.appendChild(kartu);
  });
}

function tampilkanKeranjang() {
  const tempat = document.getElementById("daftar-keranjang");
  tempat.innerHTML = "";

  let jumlah = 0;
  let total = 0;

  Object.values(keranjang).forEach((item) => {
    jumlah += item.jumlah;
    total += item.harga * item.jumlah;

    const baris = document.createElement("div");
    baris.className = "item-keranjang";

    const keterangan = document.createElement("span");
    keterangan.textContent =
      item.nama + " × " + item.jumlah + " — " +
      formatRupiah(item.harga * item.jumlah);

    const kontrol = document.createElement("div");

    const kurang = document.createElement("button");
    kurang.textContent = "−";
    kurang.setAttribute("aria-label", "Kurangi " + item.nama);
    kurang.onclick = () => {
      item.jumlah--;
      if (item.jumlah <= 0) delete keranjang[item.nama];
      tampilkanKeranjang();
    };

    const tambah = document.createElement("button");
    tambah.textContent = "+";
    tambah.setAttribute("aria-label", "Tambah " + item.nama);
    tambah.onclick = () => {
      item.jumlah++;
      tampilkanKeranjang();
    };

    kontrol.append(kurang, tambah);
    baris.append(keterangan, kontrol);
    tempat.appendChild(baris);
  });

  if (jumlah === 0) {
    tempat.textContent = "Belum ada pesanan.";
  }

  document.getElementById("jumlah").textContent = jumlah;
  document.getElementById("total").textContent = formatRupiah(total);
}

document.getElementById("form-pesanan").addEventListener(
  "submit",
  function (event) {
    event.preventDefault();

    if (Object.keys(keranjang).length === 0) {
      alert("Pilih makanan atau minuman terlebih dahulu.");
      return;
    }

    const nama = document.getElementById("nama").value.trim();
    const cara = document.getElementById("cara").value;
    const catatan = document.getElementById("catatan").value.trim();

    const total = Object.values(keranjang).reduce(
      (jumlah, item) => jumlah + item.harga * item.jumlah,
      0
    );

    const nomor = "BN-" + Date.now().toString().slice(-6);
    const rincian = Object.values(keranjang)
      .map(item => item.nama + " x " + item.jumlah)
      .join(", ");

    const hasil = document.getElementById("hasil-pesanan");
    hasil.replaceChildren();

    const judul = document.createElement("h3");
    judul.textContent = "Pesanan berhasil dibuat!";

    const detail = document.createElement("p");
    detail.textContent =
      "Nomor: " + nomor +
      " | Pemesan: " + nama +
      " | Cara: " + cara +
      " | Menu: " + rincian +
      " | Total: " + formatRupiah(total) +
      (catatan ? " | Catatan: " + catatan : "");

    hasil.append(judul, detail);

    alert("Pesanan berhasil dibuat.\nNomor pesanan: " + nomor);

    for (const namaMenu in keranjang) {
      delete keranjang[namaMenu];
    }

    this.reset();
    tampilkanKeranjang();
  }
);

tampilkanMenu(dataMakanan, "makanan");
tampilkanMenu(dataMinuman, "minuman");
tampilkanKeranjang();
