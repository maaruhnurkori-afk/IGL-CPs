* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #fffaf2;
  color: #292929;
}

header {
  background: #176b3a;
  color: white;
  text-align: center;
  padding: 25px 15px;
}

header h1 {
  margin-bottom: 8px;
}

.banner {
  padding: 55px 20px;
  text-align: center;
  color: white;
  background: linear-gradient(120deg, #174b2d, #53a568);
}

.banner h2 {
  font-size: 30px;
  margin-bottom: 12px;
}

main {
  max-width: 1100px;
  margin: auto;
  padding: 25px 18px;
}

main > h2 {
  color: #176b3a;
  margin: 25px 0 15px;
}

.daftar-menu {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 18px;
}

.kartu {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 3px 12px #00000015;
  border: 1px solid #eee;
}

.kartu img {
  width: 100%;
  height: 170px;
  object-fit: cover;
  display: block;
}

.isi-kartu {
  padding: 15px;
}

.isi-kartu h3 {
  margin-bottom: 9px;
}

.harga {
  color: #176b3a;
  font-weight: bold;
  margin-bottom: 12px;
}

button {
  background: #176b3a;
  color: white;
  border: none;
  border-radius: 7px;
  padding: 11px 14px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background: #10512b;
}

.isi-kartu button {
  width: 100%;
}

.keranjang {
  background: white;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 3px 12px #00000012;
}

#daftar-keranjang {
  margin: 15px 0;
}

.item-keranjang {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.item-keranjang button {
  padding: 6px 10px;
  margin-left: 5px;
}

.keranjang h3 {
  color: #176b3a;
  margin: 18px 0;
}

form label {
  display: block;
  font-weight: bold;
  margin: 15px 0 7px;
}

input, select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 7px;
  font: inherit;
}

textarea {
  min-height: 75px;
  resize: vertical;
}

form button {
  width: 100%;
  margin-top: 20px;
  font-size: 16px;
}

#hasil-pesanan {
  margin-top: 18px;
  line-height: 1.8;
}

footer {
  background: #174b2d;
  color: white;
  text-align: center;
  padding: 20px;
  margin-top: 35px;
}

@media (max-width: 480px) {
  .banner h2 {
    font-size: 24px;
  }

  .daftar-menu {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .kartu img {
    height: 125px;
  }
}
