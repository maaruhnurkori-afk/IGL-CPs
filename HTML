<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pemesanan Makanan Bu Nana</title>
  <link rel="stylesheet" href="style.css">
  <script src="script.js" defer></script>
</head>
<body>
  <header>
    <h1>🍽️ Warung Bu Nana</h1>
    <p>Enak, hemat, dan selalu menggugah selera!</p>
  </header>

  <section class="banner">
    <h2>Selamat Datang di Bu Nana</h2>
    <p>Pilih menu favoritmu dan pesan dengan mudah.</p>
  </section>

  <main>
    <h2>Menu Makanan</h2>
    <div id="makanan" class="daftar-menu"></div>

    <h2>Menu Minuman</h2>
    <div id="minuman" class="daftar-menu"></div>

    <h2>Keranjang Pesanan 🛒</h2>
    <section class="keranjang">
      <p>Jumlah item: <span id="jumlah">0</span></p>
      <div id="daftar-keranjang">Belum ada pesanan.</div>
      <h3>Total: <span id="total">Rp0</span></h3>

      <form id="form-pesanan">
        <label for="nama">Nama pemesan</label>
        <input id="nama" type="text" placeholder="Masukkan nama" required>

        <label for="cara">Cara menerima pesanan</label>
        <select id="cara" required>
          <option value="">Pilih cara menerima</option>
          <option value="Makan di tempat">Makan di tempat</option>
          <option value="Dibungkus">Dibungkus</option>
        </select>

        <label for="catatan">Catatan (opsional)</label>
        <textarea id="catatan" placeholder="Contoh: tidak pedas"></textarea>

        <button type="submit">Buat Pesanan</button>
      </form>

      <div id="hasil-pesanan" aria-live="polite"></div>
    </section>
  </main>

  <footer>
    <p>© 2026 Warung Bu Nana | Terima kasih sudah memesan ❤️</p>
  </footer>
</body>
</html>
